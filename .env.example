# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to the repository.

# Public site address (used for SEO links), e.g. https://resultsmarketing.co
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only, e.g. 2348012345678
# The floating WhatsApp button stays hidden until this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Coming in later stages ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        (server only)
# ANTHROPIC_API_KEY=                (server only – Results AI)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=    (Google Analytics 4)
# NEXT_PUBLIC_BOOKING_URL=          (e.g. your Cal.com or Calendly link)
